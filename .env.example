# CareFlow Platform Configuration Example

# Core Backend
PROJECT_NAME="CareFlow"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Default: Async SQLite for local instant run, or PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./careflow.db"
# DATABASE_URL="postgresql+asyncpg://careflow_user:careflow_pass@localhost:5432/careflow"

# Redis & Pub/Sub (Optional: falls back to in-memory pubsub if not provided)
REDIS_URL="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# AI Integration (100% Local Terminal LLM via Ollama)
# Start Ollama in terminal first: `ollama run llama3`
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
OLLAMA_TIMEOUT=30.0

# Public Verification URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Super Admin Security Allowlist (comma-separated, normalized)
SUPER_ADMIN_EMAILS="edure6377@gmail.com,superadmin@careflow.com"

# 2FA Email Verification Service (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="edure6377@gmail.com"
SMTP_PASSWORD="your-16-char-gmail-app-password"
SMTP_FROM_EMAIL="CareFlow Security <edure6377@gmail.com>"
SMTP_USE_TLS=True
